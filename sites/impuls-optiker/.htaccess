# Impuls Optiker, Entwurf auf dev.likovo.de
# Kompression, Browser-Cache und MIME-Typ für das 3D-Modell. Alle Blöcke greifen nur, wenn das Modul aktiv ist.
<IfModule mod_mime.c>
  AddType model/gltf-binary .glb
  AddType font/woff2 .woff2
  AddType image/webp .webp
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript image/svg+xml model/gltf-binary text/plain
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.(webp|svg|woff2|js|glb)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  Header always set X-Robots-Tag "noindex, nofollow"
</IfModule>
Options -Indexes
