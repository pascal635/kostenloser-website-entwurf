# Website offline (offene Rechnungen). Jede Anfrage zeigt eine leere weisse Seite.
Options -Indexes
DirectoryIndex offline.html

<IfModule mod_headers.c>
  Header set X-Robots-Tag "noindex, nofollow"
  Header set Cache-Control "no-store, max-age=0"
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{REQUEST_FILENAME} !offline\.html$
  RewriteRule ^ offline.html [L]
</IfModule>
