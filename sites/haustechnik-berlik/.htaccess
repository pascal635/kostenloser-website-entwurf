# Haustechnik Berlik, Staging unter dev.likovo.de/haustechnik-berlik/
# Kein Domain-Redirect, kein Caching-Zwang. Vor allem: nicht indexieren.

ErrorDocument 404 /haustechnik-berlik/404.html

<IfModule mod_headers.c>
  Header set X-Robots-Tag "noindex, nofollow"
  Header set X-Content-Type-Options "nosniff"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/json text/xml
</IfModule>

AddType image/webp .webp
AddType font/woff2 .woff2
